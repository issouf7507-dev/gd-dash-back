# Copier en .env et adapter (./scripts/setup-mysql-local.sh crée la base et l'utilisateur correspondants)
NODE_ENV=development
PORT=4000
# Production : HOST=127.0.0.1 (API joignable seulement par Nginx). Vide en local.
HOST=
LOG_LEVEL=debug

# MySQL local (Homebrew, port 3306) — utilisateur dédié au projet, jamais root
# Mot de passe : 12+ caractères avec majuscule, minuscule, chiffre et caractère spécial (- ou _ : pas besoin d’encodage dans l’URL)
DATABASE_URL="mysql://gd:CHANGER_MOI@127.0.0.1:3306/gd"
# Base temporaire utilisée par `prisma migrate dev` pour vérifier les migrations
SHADOW_DATABASE_URL="mysql://gd:CHANGER_MOI@127.0.0.1:3306/gd_shadow"

# Origine autorisée pour le front (Vite)
CORS_ORIGIN=http://localhost:5180

# Session : secret de signature des jetons (64+ caractères aléatoires) et durée
JWT_SECRET=CHANGER_MOI_secret_de_64_caracteres_minimum_genere_aleatoirement_xxxxxxxx
SESSION_HOURS=8

# Compte administrateur créé par `pnpm --filter @gd/server db:seed`
SEED_ADMIN_EMAIL=admin@gd.local
SEED_ADMIN_PASSWORD=CHANGER_MOI

# ─── Import des devis depuis les mails SolutionsBTP ───────────────
# off (désactivé) · dossier (lit les .eml de IMPORT_MAIL_DOSSIER, pour tester) · imap (lit la boîte mail)
IMPORT_MAIL_SOURCE=off
IMPORT_MAIL_DOSSIER=data/mails-entrants
IMPORT_MAIL_STOCKAGE=data/imports
IMPORT_MAIL_INTERVALLE_MIN=5
# false : tout passe par « À vérifier » (recommandé au début)
IMPORT_MAIL_AUTO=false
# Ex. solutionsbtp.fr,devis@monentreprise.fr — vide : tous les mails du libellé
IMPORT_MAIL_EXPEDITEURS=
# Gmail : validation en 2 étapes + « mot de passe d'application » (jamais le vrai mot de passe)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_LIBELLE=GD-Devis
IMAP_JOURS=30

# ─── Demandes de devis des clients (boîte contact@ sur Outlook / Microsoft 365) ───
# off (désactivé) · dossier (lit les .eml de DEMANDES_DOSSIER, pour tester) · graph (lit la boîte Outlook)
DEMANDES_SOURCE=off
DEMANDES_DOSSIER=data/demandes-entrantes
DEMANDES_STOCKAGE=data/demandes
DEMANDES_INTERVALLE_MIN=5
DEMANDES_JOURS=14
# Application Microsoft Entra (portail entra.microsoft.com) avec la permission Microsoft Graph « Mail.Read » (Application)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_BOITE=contact@gdcouverture.fr
GRAPH_DOSSIER=inbox

# ─── Envoi des relances de facture par email ───────────────────────
# off : l'email s'ouvre dans la messagerie de l'utilisateur (comme avant)
# dossier : écrit chaque email en .eml dans ENVOI_MAIL_DOSSIER, sans rien envoyer (pour tester)
# graph : envoyé par le serveur depuis GRAPH_BOITE (copie dans ses « Éléments envoyés »).
#         L'application Entra ci-dessus doit avoir en plus la permission Microsoft Graph « Mail.Send » (Application).
ENVOI_MAIL=off
ENVOI_MAIL_DOSSIER=data/mails-sortants
# Photos du journal de chantier (à inclure dans les sauvegardes)
PHOTOS_STOCKAGE=data/photos
# Adresse du front dans les liens envoyés par email (invitation, mot de passe oublié). Vide : CORS_ORIGIN.
APP_URL=
